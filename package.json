{
  "name": "desafio",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "db:up": "bun run src/infra/migrate.ts up",
    "db:down": "bun run src/infra/migrate.ts down",
    "db:status": "bun run src/infra/migrate.ts status",
    "test:unit": "bun test test/money.test.ts test/wallet.test.ts test/wallet-ledger-entry.test.ts test/wager-transaction.test.ts",
    "test:integration": "bun test test/persistence.test.ts test/concurrency.test.ts"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.7",
    "@nestjs/cli": "^12.0.11",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.7",
    "@mikro-orm/decorators": "^7.2.7",
    "@mikro-orm/migrations": "^7.2.7",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.7",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
